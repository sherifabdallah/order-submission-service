{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Data Source=App_Data/orders.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": true
  },
  "Notifications": {
    "Delivery": {
      "MaxAttempts": 8,
      "InitialRetryDelay": "00:00:02",
      "MaxRetryDelay": "00:05:00",
      "JitterRatio": 0.2,
      "SendTimeout": "00:00:10",
      "LeaseDuration": "00:01:00"
    },
    "Dispatcher": {
      "Enabled": true,
      "BatchSize": 50,
      "MaxConcurrency": 8,
      "PollingInterval": "00:00:01"
    },
    "FakeService": {
      "Mode": "Healthy",
      "FailureRate": 0.5,
      "Latency": "00:00:00.250",
      "AllowRuntimeChanges": true
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 60,
    "Window": "00:00:10"
  }
}
